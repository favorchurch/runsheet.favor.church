{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "src/**/*.jsx",
    "src/**/*.js",
    "src/**/*.module.css",
    "tests/**/*.ts",
    "src/components/AttendanceRateTable/columns/useColumnConnectGroupSimpletsx",
    "tests/unit/signups.skip",
    "tests/unit/checkin.skip",
    "tests/unit/carenotes.test.skip"
  ],
  "exclude": ["node_modules", "ext", ".worktrees"]
}
